{
  "name": "dsh-usage-bar",
  "version": "1.0.0",
  "description": "DSH web plugin: total token consumption and cache-hit rate pinned above the sidebar Settings row.",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node build.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "usage",
    "tokens",
    "token-usage",
    "cache-hit-rate",
    "sidebar"
  ],
  "author": {
    "name": "lsl1931",
    "url": "https://github.com/lsl1931"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lsl1931/dsh-usage-bar.git"
  },
  "homepage": "https://github.com/lsl1931/dsh-usage-bar#readme",
  "bugs": {
    "url": "https://github.com/lsl1931/dsh-usage-bar/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  }
}
